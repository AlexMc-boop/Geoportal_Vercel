# Copia este archivo a `.env` (local) o configúralo en Vercel:
#   Vercel > Proyecto > Settings > Environment Variables
# Las credenciales NUNCA deben ir en el código ni en el repositorio.

# URL base de tu proyecto Supabase (sin /rest/v1)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anon (pública para lectura con RLS) o service_role (solo si necesitas más permisos)
SUPABASE_ANON_KEY=tu_clave_anon
